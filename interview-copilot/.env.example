# Copy to .env and fill in the key. Nothing else is required to start.
OPENAI_API_KEY=

# Model routing. These are the spec defaults. If your account does not have
# access to a given ID, the app logs the rejection once and retries that call on
# FALLBACK_MODEL — but set the right IDs here for predictable latency.
ROUTER_MODEL=gpt-5.6-luna
SPECIALIST_MODEL=gpt-5.6-terra
EDITOR_MODEL=gpt-5.6-terra
DEEP_MODEL=gpt-5.6-sol
TRANSCRIBE_MODEL=gpt-4o-transcribe

# Used only when a configured model ID is rejected.
FALLBACK_MODEL=gpt-4.1
FALLBACK_TRANSCRIBE_MODEL=whisper-1

DATABASE_URL=sqlite+aiosqlite:///./interview.db
CORS_ORIGINS=http://localhost:5173

# Include raw specialist notes in the debug drawer. Useful while tuning,
# noisy during a live interview.
DEBUG_AGENT_OUTPUT=false

LOG_LEVEL=INFO

# Live interview: fail fast rather than hang.
ROUTER_TIMEOUT_S=8
SPECIALIST_TIMEOUT_S=45
EDITOR_TIMEOUT_S=60
TRANSCRIBE_TIMEOUT_S=45
