[
  {
    "id": "oauth_token_expiry",
    "category": "oauth",
    "prompt": "Our integration starts returning 401s from the provider a few hours into the day. What's going on and how do you handle it?",
    "expect": {
      "modes": ["debugging", "scenario", "integration_implementation", "concept"],
      "domains": ["integration", "reliability"],
      "must_include_any": [["refresh", "refresh token"], ["expir", "401"]],
      "must_not_include": ["kafka", "redis cluster"],
      "max_words": 300
    }
  },
  {
    "id": "refresh_token_revoked",
